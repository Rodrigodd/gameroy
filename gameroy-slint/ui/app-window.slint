import { Library, RomRow } from "library.slint";
import { EmulatorView, BreakRow, WatchRow, DisasmRow, SpriteCell } from "emulator.slint";
import { PauseMenu } from "pause-menu.slint";

export { RomRow, BreakRow, WatchRow, DisasmRow, SpriteCell }

// The root is deliberately thin: focus and key handling, and a choice between
// the library and the emulator. The screens themselves are components.
export component AppWindow inherits Window {
    // --- input ---
    //
    // Only the joypad and the two hold-to-act keys go through key-pressed and
    // key-released, because those need to know whether the key is down. Every
    // momentary action is a KeyBinding below, which is declarative and cannot
    // drift out of sync with the UI the way a hand-rolled dispatch can.
    callback key_pressed(KeyEvent);
    callback key_release(KeyEvent);
    /// True when the key is one the joypad or a hold action uses.
    pure callback is_handled_key(string) -> bool;

    // --- shortcut actions ---
    callback save_state();
    callback load_state();
    callback toggle_debugger();
    callback debug_step();
    callback debug_step_back();
    callback toggle_run();
    callback toggle_menu();

    // --- menu ---
    callback menu_save_state();
    callback menu_load_state();
    callback menu_reset();
    callback menu_close();
    callback menu_exit();

    in property <string> window_title: "GameRoy";
    in property <string> status_text;
    in property <bool> menu_open;
    /// False shows the ROM library instead of the emulator.
    in property <bool> playing;
    /// A file is being dragged over the window. Set from the winit hook in main.rs,
    /// not from a DropArea: see the comment there.
    in property <bool> drop_hover;

    // --- emulator ---
    in property <image> screen;
    in property <bool> integer_scaling;
    in property <bool> debugging;
    in property <string> cpu_text;
    in property <string> ppu_text;
    in property <[BreakRow]> breakpoints;
    in property <[WatchRow]> watches;
    in property <[string]> console_lines;
    in property <[DisasmRow]> disasm_rows;
    in property <int> disasm_total;
    in property <int> disasm_focus_index;
    in property <int> disasm_focus_token;
    callback disasm_jump_to(int, int, int);
    callback disasm_toggle_breakpoint(int);
    callback disasm_visible_range_changed(int, int);
    in-out property <bool> show_ppu_viewer;
    in property <image> ppu_tiles;
    in property <image> ppu_background;
    in property <image> ppu_window;
    in property <[SpriteCell]> ppu_oam;
    in property <[SpriteCell]> ppu_sprite_buffer;
    in property <int> ppu_sprite_buffer_len;
    in property <[int]> ppu_background_tiles;
    in property <[int]> ppu_window_tiles;
    in property <bool> ppu_tall_sprites;
    in property <string> ppu_background_fifo;
    in property <string> ppu_sprite_fifo;
    callback ppu_viewer_toggled(bool);
    callback remove_breakpoint(int);
    callback remove_watch(int);
    callback submit_command(string);

    // --- library ---
    in property <[RomRow]> roms;
    in property <int> sort_column;
    in property <bool> sort_ascending;
    in property <string> folder_text;
    in property <int> selected_rom: -1;
    callback sort_by(int);
    callback activate_rom(int);
    callback select_rom(int);
    callback pick_rom();
    callback pick_folder();

    title: root.window_title;
    min-width: 160px;
    min-height: 144px;
    preferred-width: 480px;
    preferred-height: 432px;
    background: #101210;
    forward-focus: scope;

    scope := FocusScope {
        key-pressed(event) => {
            if (root.is_handled_key(event.text)) {
                root.key_pressed(event);
                accept
            } else {
                reject
            }
        }

        key-released(event) => {
            if (root.is_handled_key(event.text)) {
                root.key_release(event);
                accept
            } else {
                reject
            }
        }

        // Shortcuts. `enabled` gates them on there being a game, so the library
        // screen does not react to F8 -- which beats checking `playing` again on
        // the Rust side of every handler.
        KeyBinding {
            keys: @keys(F5);
            enabled: root.playing;
            activated => { root.save_state(); }
        }
        KeyBinding {
            keys: @keys(F6);
            enabled: root.playing;
            activated => { root.load_state(); }
        }
        KeyBinding {
            keys: @keys(F7);
            enabled: root.playing;
            activated => { root.debug_step_back(); }
        }
        KeyBinding {
            keys: @keys(F8);
            enabled: root.playing;
            activated => { root.debug_step(); }
        }
        KeyBinding {
            keys: @keys(F9);
            enabled: root.playing;
            activated => { root.toggle_run(); }
        }
        KeyBinding {
            keys: @keys(F12);
            enabled: root.playing;
            activated => { root.toggle_debugger(); }
        }
        KeyBinding {
            keys: @keys(M);
            enabled: root.playing;
            activated => { root.toggle_menu(); }
        }
    }

    if !root.playing: Library {
        roms: root.roms;
        sort-column: root.sort_column;
        sort-ascending: root.sort_ascending;
        folder-text: root.folder_text;
        selected: root.selected_rom;
        sort-by(i) => { root.sort_by(i); }
        activate(i) => { root.activate_rom(i); }
        select(i) => { root.select_rom(i); }
        pick-rom() => { root.pick_rom(); }
        pick-folder() => { root.pick_folder(); }
    }

    if root.playing: EmulatorView {
        frame: root.screen;
        integer-scaling: root.integer_scaling;
        debugging: root.debugging;
        cpu-text: root.cpu_text;
        ppu-text: root.ppu_text;
        breakpoints: root.breakpoints;
        watches: root.watches;
        console-lines: root.console_lines;
        disasm-rows: root.disasm_rows;
        disasm-total: root.disasm_total;
        disasm-focus-index: root.disasm_focus_index;
        disasm-focus-token: root.disasm_focus_token;
        disasm-jump-to(i, b, a) => { root.disasm_jump_to(i, b, a); }
        disasm-toggle-breakpoint(a) => { root.disasm_toggle_breakpoint(a); }
        disasm-visible-range-changed(f, c) => { root.disasm_visible_range_changed(f, c); }
        show-ppu-viewer <=> root.show_ppu_viewer;
        ppu-tiles: root.ppu_tiles;
        ppu-background: root.ppu_background;
        ppu-window: root.ppu_window;
        ppu-oam: root.ppu_oam;
        ppu-sprite-buffer: root.ppu_sprite_buffer;
        ppu-sprite-buffer-len: root.ppu_sprite_buffer_len;
        ppu-background-tiles: root.ppu_background_tiles;
        ppu-window-tiles: root.ppu_window_tiles;
        ppu-tall-sprites: root.ppu_tall_sprites;
        ppu-background-fifo: root.ppu_background_fifo;
        ppu-sprite-fifo: root.ppu_sprite_fifo;
        ppu-viewer-toggled(shown) => { root.ppu_viewer_toggled(shown); }
        remove-breakpoint(a) => { root.remove_breakpoint(a); }
        remove-watch(a) => { root.remove_watch(a); }
        submit-command(line) => { root.submit_command(line); }
    }

    if root.menu_open && root.playing: PauseMenu {
        save-state() => { root.menu_save_state(); }
        load-state() => { root.menu_load_state(); }
        reset() => { root.menu_reset(); }
        exit-game() => { root.menu_exit(); }
        close() => { root.menu_close(); }
    }

    // Drawn above everything, including the pause menu: a drop lands whatever is
    // on screen, so the invitation has to be visible from any of them.
    if root.drop_hover: Rectangle {
        background: #000000b0;
        Text {
            text: "Drop a .gb ROM to play";
            color: #cfe3cf;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
