import { Button, VerticalBox } from "std-widgets.slint";
import { Library, RomRow } from "library.slint";
import { DebugPanel, BreakRow, WatchRow } from "debugger.slint";
import { DisassemblyView, DisasmRow } from "disassembly.slint";

export { RomRow, BreakRow, WatchRow, DisasmRow }

export component AppWindow inherits Window {
    /// Every key the app handles is dispatched from Rust, so the keymap lives in
    /// exactly one place rather than being split across the UI and the host.
    callback key_pressed(KeyEvent);
    callback key_release(KeyEvent);
    /// True when the key does something, so the FocusScope knows to consume it.
    pure callback is_handled_key(string) -> bool;

    callback menu_save_state();
    callback menu_load_state();
    callback menu_reset();
    callback menu_close();
    callback menu_exit();

    in property <image> screen;
    in property <string> status_text;

    // --- debugger ---
    in property <bool> debugging;
    in property <string> cpu_text;
    in property <string> ppu_text;
    in property <[BreakRow]> breakpoints;
    in property <[WatchRow]> watches;
    in property <[string]> console_lines;
    in property <[DisasmRow]> disasm_rows;
    in property <int> disasm_total;
    in property <int> disasm_start;
    in-out property <length> panel_width: 260px;
    callback remove_breakpoint(int);
    callback remove_watch(int);
    callback submit_command(string);
    in property <string> window_title: "GameRoy";
    in property <bool> menu_open;
    /// False shows the ROM library instead of the emulator.
    in property <bool> playing;
    /// Scale the screen by whole pixels only. Off means fill while keeping the
    /// 160x144 aspect ratio, which uses the window better on odd sizes.
    in property <bool> integer_scaling;

    // --- library ---
    in property <[RomRow]> roms;
    in property <int> sort_column;
    in property <bool> sort_ascending;
    in property <string> folder_text;
    in property <int> selected_rom: -1;
    callback sort_by(int);
    callback activate_rom(int);
    callback select_rom(int);
    callback pick_rom();
    callback pick_folder();

    title: root.window_title;
    min-width: 160px;
    min-height: 144px;
    preferred-width: 480px;
    preferred-height: 432px;
    background: #101210;
    forward-focus: scope;

    scope := FocusScope {
        key-pressed(event) => {
            if (root.is_handled_key(event.text)) {
                root.key_pressed(event);
                accept
            } else {
                reject
            }
        }

        key-released(event) => {
            if (root.is_handled_key(event.text)) {
                root.key_release(event);
                accept
            } else {
                reject
            }
        }
    }

    if !root.playing: Library {
        roms: root.roms;
        sort-column: root.sort_column;
        sort-ascending: root.sort_ascending;
        folder-text: root.folder_text;
        selected: root.selected_rom;
        sort-by(i) => { root.sort_by(i); }
        activate(i) => { root.activate_rom(i); }
        select(i) => { root.select_rom(i); }
        pick-rom() => { root.pick_rom(); }
        pick-folder() => { root.pick_folder(); }
    }

    if root.playing: HorizontalLayout {
        // The emulated screen, scaled by whole pixels only and centred.
        Rectangle {
            horizontal-stretch: 1;
            Image {
                // Whole-pixel scale factor, at least 1.
                property <int> int-scale: max(1, min(parent.width / 160px, parent.height / 144px));
                // Fractional factor that fits the box while keeping the aspect ratio.
                property <float> fit-scale: min(parent.width / 160px, parent.height / 144px);
                property <float> scale: root.integer_scaling ? int-scale : max(1.0, fit-scale);

                // Pin the layout constraints to the native resolution: otherwise the
                // Image's implicit preferred size follows its scaled width, which the
                // window's layout info depends on -> binding loop.
                preferred-width: 160px;
                preferred-height: 144px;

                width: 160px * scale;
                height: 144px * scale;

                source: root.screen;
                // Pixelated only makes sense at whole-pixel scales; smoothing a
                // fractional scale avoids uneven pixel sizes.
                image-rendering: root.integer_scaling ? ImageRendering.pixelated : ImageRendering.smooth;
            }
        }

        if root.debugging: DisassemblyView {
            width: 330px;
            rows: root.disasm_rows;
            total: root.disasm_total;
            start-index: root.disasm_start;
        }

        // Draggable divider. Slint has no splitter widget, so this is the whole
        // of it: a thin strip that adjusts the panel width as it is dragged.
        if root.debugging: Rectangle {
            width: 5px;
            background: divider.has-hover || divider.pressed ? #3a4a3a : #232a23;
            divider := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    // Dragging left widens the panel, so the delta is negated.
                    root.panel_width = clamp(
                        root.panel_width - (self.mouse-x - self.pressed-x),
                        160px,
                        root.width - 160px);
                }
            }
        }

        if root.debugging: DebugPanel {
            width: root.panel_width;
            cpu-text: root.cpu_text;
            ppu-text: root.ppu_text;
            breakpoints: root.breakpoints;
            watches: root.watches;
            console-lines: root.console_lines;
            remove-breakpoint(a) => { root.remove_breakpoint(a); }
            remove-watch(a) => { root.remove_watch(a); }
            submit-command(line) => { root.submit_command(line); }
        }
    }

    // Pause menu. Emulation is paused while this is up.
    if root.menu_open && root.playing: Rectangle {
        // Blocker: swallows clicks so they cannot reach anything behind, and
        // closes the menu, matching the old front-end's click-away behaviour.
        background: #00000099;
        TouchArea {
            clicked => { root.menu_close(); }
        }

        Rectangle {
            width: 220px;
            height: menu_layout.preferred-height;
            y: parent.height - self.height;
            background: #1b201b;
            border-radius: 6px;
            // Slide up from the bottom edge.
            animate y { duration: 180ms; easing: ease-out; }

            menu_layout := VerticalBox {
                spacing: 6px;
                Text {
                    text: "Paused";
                    color: #9fd39f;
                    horizontal-alignment: center;
                }
                Button {
                    text: "Save State";
                    clicked => { root.menu_save_state(); }
                }
                Button {
                    text: "Load State";
                    clicked => { root.menu_load_state(); }
                }
                Button {
                    text: "Reset";
                    clicked => { root.menu_reset(); }
                }
                Button {
                    text: "Exit Game";
                    clicked => { root.menu_exit(); }
                }
                Button {
                    text: "Resume";
                    clicked => { root.menu_close(); }
                }
            }
        }
    }
}
