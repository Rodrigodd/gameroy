import { Library } from "library.slint";
import { EmulatorView } from "emulator.slint";
import { PauseMenu } from "pause-menu.slint";
import { LibraryState, DebuggerState, DisasmState, PpuState,
    RomRow, BreakRow, WatchRow, DisasmRow, SpriteCell } from "state.slint";

// A global is only reachable from Rust if the compiled entry file exports it.
export { LibraryState, DebuggerState, DisasmState, PpuState }
export { RomRow, BreakRow, WatchRow, DisasmRow, SpriteCell }

// The root is deliberately thin: focus and key handling, and a choice between
// the library and the emulator. The screens themselves are components.
export component AppWindow inherits Window {
    // --- input ---
    //
    // Only the joypad and the two hold-to-act keys go through key-pressed and
    // key-released, because those need to know whether the key is down. Every
    // momentary action is a KeyBinding below, which is declarative and cannot
    // drift out of sync with the UI the way a hand-rolled dispatch can.
    callback key_pressed(KeyEvent);
    callback key_release(KeyEvent);
    /// True when the key is one the joypad or a hold action uses.
    pure callback is_handled_key(string) -> bool;

    // --- menu ---
    callback menu_save_state();
    callback menu_load_state();
    callback menu_reset();
    callback menu_toggle_scaling();
    callback menu_close();
    callback menu_exit();

    in property <string> window_title: "GameRoy";
    in property <string> status_text;
    in property <bool> menu_open;
    /// False shows the ROM library instead of the emulator.
    in property <bool> playing;
    /// A file is being dragged over the window. Set from the winit hook in main.rs,
    /// not from a DropArea: see the comment there.
    in property <bool> drop_hover;

    // --- emulator ---
    in property <image> screen;
    in property <bool> integer_scaling;
    in property <bool> debugging;

    title: root.window_title;
    min-width: 160px;
    min-height: 144px;
    preferred-width: 480px;
    preferred-height: 432px;
    background: #101210;
    forward-focus: scope;

    scope := FocusScope {
        key-pressed(event) => {
            if (root.is_handled_key(event.text)) {
                root.key_pressed(event);
                accept
            } else {
                reject
            }
        }

        key-released(event) => {
            if (root.is_handled_key(event.text)) {
                root.key_release(event);
                accept
            } else {
                reject
            }
        }

    }

    if !root.playing: Library { }

    // The status line. It was set from three places -- a ROM that would not
    // read, the run state, a fatal server error -- and rendered nowhere, so all
    // three were invisible outside the log.
    if root.status_text != "": Rectangle {
        y: parent.height - self.height;
        height: 20px;
        background: #1a1f1acc;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            Text {
                text: root.status_text;
                color: #9fb39f;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    if root.playing: EmulatorView {
        frame: root.screen;
        integer-scaling: root.integer_scaling;
        debugging: root.debugging;
    }

    if root.menu_open && root.playing: PauseMenu {
        save-state() => { root.menu_save_state(); }
        load-state() => { root.menu_load_state(); }
        reset() => { root.menu_reset(); }
        integer-scaling: root.integer_scaling;
        toggle-scaling() => { root.menu_toggle_scaling(); }
        exit-game() => { root.menu_exit(); }
        close() => { root.menu_close(); }
    }

    // Drawn above everything, including the pause menu: a drop lands whatever is
    // on screen, so the invitation has to be visible from any of them.
    if root.drop_hover: Rectangle {
        background: #000000b0;
        Text {
            text: "Drop a .gb ROM to play";
            color: #cfe3cf;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
