import { Library } from "library.slint";
import { PlayScreen } from "play-screen.slint";
import { StatusBar } from "status-bar.slint";
import { DropOverlay } from "drop-overlay.slint";
import { Shell, Input } from "state.slint";

// Rust reaches a global only if the compiled entry file exports it, so this is
// the list that makes `ui.global::<X>()` work. The structs ride along on those
// globals' members; naming them is belt and braces.
export { Shell, Input, EmulatorState, MenuActions, LibraryState, DebuggerState,
    DisasmState, PpuState } from "state.slint";
export { RomRow, BreakRow, WatchRow, DisasmRow, SpriteCell } from "state.slint";

// The window shell, and nothing else. It sizes the window, routes keys to the
// host, and picks a screen; it binds no data, because every screen reaches the
// globals it needs on its own.
export component AppWindow inherits Window {
    title: Shell.window-title;
    min-width: 160px;
    min-height: 144px;
    preferred-width: 480px;
    preferred-height: 432px;
    background: #101210;
    forward-focus: scope;

    scope := FocusScope {
        key-pressed(event) => {
            if (Input.is-handled-key(event.text)) {
                Input.key-pressed(event);
                accept
            } else {
                reject
            }
        }

        key-released(event) => {
            if (Input.is-handled-key(event.text)) {
                Input.key-released(event);
                accept
            } else {
                reject
            }
        }
    }

    if !Shell.playing: Library { }
    if Shell.playing: PlayScreen { }
    if Shell.status-text != "": StatusBar { }
    if Shell.drop-hover: DropOverlay { }
}
