import { ScrollView, LineEdit } from "std-widgets.slint";
import { DebuggerState, BreakRow, WatchRow } from "state.slint";

// Re-exported so this panel can be previewed on its own with --load-data.
export { DebuggerState, BreakRow, WatchRow }

// A small "+ addr" row for adding a breakpoint or a watch without the console.
// The panel could only ever *remove* one before.
component AddEntry inherits HorizontalLayout {
    in property <string> placeholder;
    callback add(string);

    spacing: 4px;
    field := LineEdit {
        horizontal-stretch: 1;
        font-size: 11px;
        placeholder-text: root.placeholder;
        accepted(text) => {
            if (text != "") {
                root.add(text);
                self.text = "";
            }
        }
    }
    Rectangle {
        width: 18px;
        background: plus.has-hover ? #2a422a : #1a1f1a;
        border-radius: 3px;
        plus := TouchArea {
            clicked => {
                if (field.text != "") {
                    root.add(field.text);
                    field.text = "";
                }
            }
        }
        Text {
            text: "+";
            color: #9fd39f;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Collapsible section. Slint has no such widget, and the old panel stacked four
// of them, so it earns its own component.
component FoldView inherits VerticalLayout {
    in property <string> title;
    in-out property <bool> expanded: true;

    spacing: 2px;

    Rectangle {
        height: 22px;
        background: touch.has-hover ? #222922 : #1a1f1a;
        touch := TouchArea {
            clicked => { root.expanded = !root.expanded; }
        }
        HorizontalLayout {
            padding-left: 6px;
            spacing: 6px;
            Text {
                // Chevron turns to mark the state, as the old fold view did.
                text: root.expanded ? "\u{25bc}" : "\u{25b6}";
                color: #6f8f6f;
                font-size: 9px;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                color: #9fd39f;
                font-size: 12px;
                vertical-alignment: center;
            }
            // Takes the slack so the title stays beside its chevron instead of
            // being centred across the header.
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // Collapsed by height rather than by `if`, because @children may not appear
    // inside a conditional element. Clipping hides the overflow, and it gives the
    // fold something to animate.
    Rectangle {
        clip: true;
        height: root.expanded ? content.preferred-height : 0px;
        animate height { duration: 120ms; easing: ease-out; }

        content := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            @children
        }
    }
}

export component DebugPanel inherits Rectangle {
    /// Purely this panel's own layout, so it stays a property rather than
    /// joining the host contract: only the splitter below ever writes it.
    in-out property <length> console-height: 120px;

    // A `changed` handler can only watch a property of its own element, so the
    // log tracks the global through a local mirror.
    private property <[string]> console-lines: DebuggerState.console-lines;

    background: #161a16;

    // Jump to the bottom whenever a line is added, so a command's output is
    // visible without scrolling for it.
    changed console-lines => {
        log.content-y = min(0px, log.visible-height - log.content-height);
    }

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                alignment: start;

                FoldView {
                    title: "cpu";
                    Text {
                        text: DebuggerState.cpu-text;
                        color: #9fd39f;
                        font-family: "monospace";
                        font-size: 12px;
                    }
                }

                FoldView {
                    title: "ppu";
                    Text {
                        text: DebuggerState.ppu-text;
                        color: #9fd39f;
                        font-family: "monospace";
                        font-size: 12px;
                    }
                }

                FoldView {
                    title: "breaks";
                    AddEntry {
                        placeholder: "x 0150";
                        add(text) => { DebuggerState.add-breakpoint(text); }
                    }
                    if DebuggerState.breakpoints.length == 0: Text {
                        text: "none";
                        color: #5f6f5f;
                        font-size: 11px;
                    }
                    for b in DebuggerState.breakpoints: HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: b.flags-text + " " + b.address-text;
                            color: #9fd39f;
                            font-family: "monospace";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            background: del.has-hover ? #663333 : transparent;
                            border-radius: 3px;
                            del := TouchArea {
                                clicked => { DebuggerState.remove-breakpoint(b.address); }
                            }
                            Text {
                                text: "x";
                                color: #c08080;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                FoldView {
                    title: "watchs";
                    AddEntry {
                        placeholder: "ff44";
                        add(text) => { DebuggerState.add-watch(text); }
                    }
                    if DebuggerState.watches.length == 0: Text {
                        text: "none";
                        color: #5f6f5f;
                        font-size: 11px;
                    }
                    for w in DebuggerState.watches: HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: w.address-text + " = " + w.value-text;
                            color: #9fd39f;
                            font-family: "monospace";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            background: delw.has-hover ? #663333 : transparent;
                            border-radius: 3px;
                            delw := TouchArea {
                                clicked => { DebuggerState.remove-watch(w.address); }
                            }
                            Text {
                                text: "x";
                                color: #c08080;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Splits the folded sections from the console.
        Rectangle {
            height: 5px;
            background: split.has-hover || split.pressed ? #3a4a3a : #232a23;
            split := TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    // Dragging up grows the console, so the delta is negated.
                    root.console-height = clamp(
                        root.console-height - (self.mouse-y - self.pressed-y),
                        60px,
                        max(60px, root.height - 120px));
                }
            }
        }

        // Console log and input.
        Rectangle {
            height: root.console-height;
            background: #101210;
            border-radius: 3px;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                log := ScrollView {
                    vertical-stretch: 1;
                    // `alignment: end` keeps the newest line against the bottom,
                    // which is the auto-scroll: no viewport arithmetic needed
                    // while the log is shorter than the box, and the explicit
                    // scroll below covers it once it is longer.
                    VerticalLayout {
                        alignment: end;
                        for line in root.console-lines: Text {
                            text: line;
                            color: #8fae8f;
                            font-family: "monospace";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }


                input := LineEdit {
                    placeholder-text: "command (try: help)";
                    accepted(text) => {
                        DebuggerState.submit-command(text);
                        self.text = "";
                    }
                    key-pressed(event) => {
                        // Up/Down walk the history and Escape clears, as the old
                        // prompt did. LineEdit has no history of its own, so the
                        // host keeps it.
                        if (event.text == Key.UpArrow) {
                            self.text = DebuggerState.history(-1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            self.text = DebuggerState.history(1);
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            self.text = "";
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
    }
}
