import { GameScreen } from "game-screen.slint";

// A draggable vertical split. Slint has no splitter widget, so this is the whole
// of one: a thin strip that reports how far it has been dragged. The height comes
// from the enclosing layout, and the parent owns the size being adjusted, because
// only it knows what to clamp against.
component Divider inherits Rectangle {
    callback dragged(length);

    width: 5px;
    background: touch.has-hover || touch.pressed ? #3a4a3a : #232a23;

    touch := TouchArea {
        mouse-cursor: ew-resize;
        moved => { root.dragged(self.mouse-x - self.pressed-x); }
    }
}
import { DebugPanel } from "debugger.slint";
import { DisassemblyView } from "disassembly.slint";
import { PpuViewer } from "ppu-viewer.slint";
import { PpuState } from "state.slint";

// The whole playing screen: the game, and the debugger beside it when open.
export component EmulatorView inherits HorizontalLayout {
    in property <image> frame;
    in property <bool> integer-scaling;

    in property <bool> debugging;

    in-out property <length> panel-width: 260px;
    in-out property <length> centre-width: 330px;

    GameScreen {
        horizontal-stretch: 1;
        frame: root.frame;
        integer-scaling: root.integer-scaling;
    }

    // Splits the game screen from the debugger.
    if root.debugging: Divider {
        // Dragging right widens the screen, which narrows the centre column.
        dragged(d) => {
            root.centre-width = clamp(root.centre-width - d, 160px, root.width - 320px);
        }
    }

    // Centre column: disassembly or PPU viewer, as tabs.
    if root.debugging: VerticalLayout {
        width: root.centre-width;
        spacing: 0px;

        HorizontalLayout {
            height: 24px;
            spacing: 0px;
            for tab[i] in ["disassembly", "ppu"] : Rectangle {
                horizontal-stretch: 1;
                background: (PpuState.show-viewer == (i == 1)) ? #2a332a : #1a1f1a;
                TouchArea {
                    clicked => {
                        PpuState.show-viewer = i == 1;
                        PpuState.viewer-toggled(PpuState.show-viewer);
                    }
                }
                Text {
                    text: tab;
                    color: (PpuState.show-viewer == (i == 1)) ? #cfe3cf : #6f8f6f;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !PpuState.show-viewer: DisassemblyView { }
        if PpuState.show-viewer: PpuViewer { }
    }

    if root.debugging: Divider {
        // Dragging left widens the panel, so the delta is negated.
        dragged(d) => {
            root.panel-width = clamp(root.panel-width - d, 160px, root.width - 320px);
        }
    }

    if root.debugging: DebugPanel {
        width: root.panel-width;
    }
}
