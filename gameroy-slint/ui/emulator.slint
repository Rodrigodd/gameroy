import { GameScreen } from "game-screen.slint";

// A draggable vertical split. Slint has no splitter widget, so this is the whole
// of one: a thin strip that reports how far it has been dragged. The height comes
// from the enclosing layout, and the parent owns the size being adjusted, because
// only it knows what to clamp against.
component Divider inherits Rectangle {
    callback dragged(length);

    width: 5px;
    background: touch.has-hover || touch.pressed ? #3a4a3a : #232a23;

    touch := TouchArea {
        mouse-cursor: ew-resize;
        moved => { root.dragged(self.mouse-x - self.pressed-x); }
    }
}
import { DebugPanel } from "debugger.slint";
import { DisassemblyView, DisasmRow } from "disassembly.slint";
import { PpuViewer, SpriteCell } from "ppu-viewer.slint";

export { DisasmRow, SpriteCell }

// The whole playing screen: the game, and the debugger beside it when open.
export component EmulatorView inherits HorizontalLayout {
    in property <image> frame;
    in property <bool> integer-scaling;

    in property <bool> debugging;
    in property <[DisasmRow]> disasm-rows;
    in property <int> disasm-total;
    in property <int> disasm-focus-index;
    in property <int> disasm-focus-token;

    /// Which centre tab is showing: false = disassembly, true = PPU viewer.
    in-out property <bool> show-ppu-viewer;
    in property <image> ppu-tiles;
    in property <image> ppu-background;
    in property <image> ppu-window;
    in property <[SpriteCell]> ppu-oam;
    in property <[SpriteCell]> ppu-sprite-buffer;
    in property <int> ppu-sprite-buffer-len;
    in property <[int]> ppu-background-tiles;
    in property <[int]> ppu-window-tiles;
    in property <bool> ppu-tall-sprites;
    in property <string> ppu-background-fifo;
    in property <string> ppu-sprite-fifo;
    in-out property <length> panel-width: 260px;
    in-out property <length> centre-width: 330px;

    callback disasm-jump-to(int, int, int);
    callback disasm-toggle-breakpoint(int);
    callback disasm-visible-range-changed(int, int);
    callback ppu-viewer-toggled(bool);

    GameScreen {
        horizontal-stretch: 1;
        frame: root.frame;
        integer-scaling: root.integer-scaling;
    }

    // Splits the game screen from the debugger.
    if root.debugging: Divider {
        // Dragging right widens the screen, which narrows the centre column.
        dragged(d) => {
            root.centre-width = clamp(root.centre-width - d, 160px, root.width - 320px);
        }
    }

    // Centre column: disassembly or PPU viewer, as tabs.
    if root.debugging: VerticalLayout {
        width: root.centre-width;
        spacing: 0px;

        HorizontalLayout {
            height: 24px;
            spacing: 0px;
            for tab[i] in ["disassembly", "ppu"] : Rectangle {
                horizontal-stretch: 1;
                background: (root.show-ppu-viewer == (i == 1)) ? #2a332a : #1a1f1a;
                TouchArea {
                    clicked => {
                        root.show-ppu-viewer = i == 1;
                        root.ppu-viewer-toggled(root.show-ppu-viewer);
                    }
                }
                Text {
                    text: tab;
                    color: (root.show-ppu-viewer == (i == 1)) ? #cfe3cf : #6f8f6f;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !root.show-ppu-viewer: DisassemblyView {
            rows: root.disasm-rows;
            total: root.disasm-total;
            focus-index: root.disasm-focus-index;
            focus-token: root.disasm-focus-token;
            jump-to(i, b, a) => { root.disasm-jump-to(i, b, a); }
            toggle-breakpoint(a) => { root.disasm-toggle-breakpoint(a); }
            visible-range-changed(f, c) => { root.disasm-visible-range-changed(f, c); }
        }
        if root.show-ppu-viewer: PpuViewer {
            tiles: root.ppu-tiles;
            background-map: root.ppu-background;
            window-map: root.ppu-window;
            oam: root.ppu-oam;
            sprite-buffer: root.ppu-sprite-buffer;
            sprite-buffer-len: root.ppu-sprite-buffer-len;
            background-tiles: root.ppu-background-tiles;
            window-tiles: root.ppu-window-tiles;
            tall-sprites: root.ppu-tall-sprites;
            background-fifo-text: root.ppu-background-fifo;
            sprite-fifo-text: root.ppu-sprite-fifo;
        }
    }

    if root.debugging: Divider {
        // Dragging left widens the panel, so the delta is negated.
        dragged(d) => {
            root.panel-width = clamp(root.panel-width - d, 160px, root.width - 320px);
        }
    }

    if root.debugging: DebugPanel {
        width: root.panel-width;
    }
}
