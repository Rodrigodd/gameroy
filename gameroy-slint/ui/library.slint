import { Button, ListView, ScrollView } from "std-widgets.slint";
import { LibraryState, RomRow } from "state.slint";

// Re-exported so this file can be previewed on its own: --load-data only reaches
// a global exported from the file being previewed.
export { LibraryState, RomRow }

/// Width of the thumbnail column, shared by the header spacer and every row so
/// the two cannot drift apart.
global Layout {
    out property <length> thumb-column: 52px;
    out property <length> thumb-size: 44px;
    /// Tall enough for the thumbnail plus a little breathing room.
    out property <length> row-height: 52px;
}

// One clickable column header. Kept as its own component so the stretchy column
// can simply omit `width`: setting `width` at all defeats `horizontal-stretch`,
// which silently collapsed the File column to zero.
//
// Private to this table, so it reads the sort state itself rather than having it
// handed down and handed back through a callback.
component HeaderCell inherits Rectangle {
    in property <string> title;
    in property <int> index;

    background: touch.has-hover ? #222922 : #1a1f1a;

    touch := TouchArea {
        clicked => { LibraryState.sort-by(root.index); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        Text {
            text: root.title;
            color: #9fd39f;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            // Arrow marks the active column and its direction.
            text: LibraryState.sort-column == root.index ? (LibraryState.sort-ascending ? "\u{25b2}" : "\u{25bc}") : "";
            color: #6f8f6f;
            font-size: 10px;
            vertical-alignment: center;
        }
        // Soaks up the slack so the arrow stays next to its label rather than
        // drifting to the far edge of a stretchy column.
        Rectangle { horizontal-stretch: 1; }
    }
}

// A hand-built table rather than StandardTableView, whose cells are
// StandardListViewItem and therefore text only -- the thumbnail column needs an
// Image per row, which that widget cannot hold.
export component Library inherits Rectangle {
    background: #101210;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Open ROM";
                clicked => { LibraryState.pick-rom(); }
            }
            Button {
                text: "Choose Folder";
                clicked => { LibraryState.pick-folder(); }
            }
            Text {
                text: LibraryState.folder-text;
                color: #6f8f6f;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Header. Clicking a column sorts by it; clicking again reverses.
        HorizontalLayout {
            height: 26px;
            spacing: 0px;
            // Inert: there is nothing to sort a picture by, and a HeaderCell here
            // would be a click target that silently does nothing.
            Rectangle {
                width: Layout.thumb-column;
                background: #1a1f1a;
            }
            HeaderCell {
                // No width: this is the column that takes the slack.
                horizontal-stretch: 1;
                title: "File";
                index: 0;
            }
            HeaderCell {
                width: 150px;
                title: "Header Name";
                index: 1;
            }
            HeaderCell {
                width: 80px;
                title: "Size";
                index: 2;
            }
            HeaderCell {
                width: 110px;
                title: "Last played";
                index: 3;
            }
        }

        ListView {
            for row[i] in LibraryState.roms: Rectangle {
                height: Layout.row-height;
                background: LibraryState.selected == i
                    ? #2c3a2c
                    : (row-touch.has-hover ? #1a1f1a : transparent);

                row-touch := TouchArea {
                    clicked => { LibraryState.select(i); }
                    double-clicked => { LibraryState.activate(i); }
                }

                HorizontalLayout {
                    spacing: 0px;
                    Rectangle {
                        width: Layout.thumb-column;
                        // The frame is drawn whether or not there is box art, so
                        // a row without one is an empty slot rather than a gap
                        // that makes the column look ragged.
                        Rectangle {
                            width: Layout.thumb-size;
                            height: Layout.thumb-size;
                            background: #1a1f1a;
                            border-radius: 3px;
                            Image {
                                source: row.thumb;
                                width: parent.width;
                                height: parent.height;
                                // The cache is 96x96 shown at 44: smoothing beats
                                // the shimmer a non-integer pixelated scale gives.
                                image-rendering: smooth;
                            }
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: row.file;
                        color: #cfe3cf;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: 150px;
                        text: row.title;
                        color: row.loading ? #6f8f6f : #9fb39f;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: 80px;
                        text: row.size;
                        color: #9fb39f;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 110px;
                        text: row.last-played;
                        color: #9fb39f;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if LibraryState.roms.length == 0: Text {
            text: "No .gb files found. Use \"Choose Folder\" to pick a ROM folder.";
            color: #6f8f6f;
            horizontal-alignment: center;
        }
    }
}
