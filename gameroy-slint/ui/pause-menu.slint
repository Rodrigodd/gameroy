import { Button, VerticalBox } from "std-widgets.slint";
import { EmulatorState, MenuActions } from "state.slint";

// Re-exported so this menu can be previewed on its own with --load-data.
export { EmulatorState, MenuActions }

// The in-game pause menu. Emulation is paused for as long as it is up.
export component PauseMenu inherits Rectangle {
    // Blocker: swallows clicks so none reach what is behind, and closes on a
    // click away, as the old front-end did.
    background: #00000099;

    TouchArea {
        clicked => { MenuActions.close(); }
    }

    Rectangle {
        width: 220px;
        height: layout.preferred-height;
        y: parent.height - self.height;
        background: #1b201b;
        border-radius: 6px;
        // Slide up from the bottom edge.
        animate y { duration: 180ms; easing: ease-out; }

        layout := VerticalBox {
            spacing: 6px;
            Text {
                text: "Paused";
                color: #9fd39f;
                horizontal-alignment: center;
            }
            Button {
                text: "Save State";
                clicked => { MenuActions.save-state(); }
            }
            Button {
                text: "Load State";
                clicked => { MenuActions.load-state(); }
            }
            Button {
                text: EmulatorState.integer-scaling ? "Scaling: whole pixels" : "Scaling: fit";
                clicked => { MenuActions.toggle-scaling(); }
            }
            Button {
                text: "Reset";
                clicked => { MenuActions.reset(); }
            }
            Button {
                text: "Exit Game";
                clicked => { MenuActions.exit-game(); }
            }
            Button {
                text: "Resume";
                clicked => { MenuActions.close(); }
            }
        }
    }
}
