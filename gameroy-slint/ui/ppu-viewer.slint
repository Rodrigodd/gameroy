import { ScrollView } from "std-widgets.slint";
import { SpriteGrid } from "sprite-grid.slint";
import { TileMapView } from "tile-map-view.slint";
import { PpuState, SpriteCell } from "state.slint";

// Re-exported so this tab can be previewed on its own with --load-data.
export { PpuState, SpriteCell }

component SectionLabel inherits Text {
    color: #6f8f6f;
    font-size: 11px;
}

export component PpuViewer inherits Rectangle {
    background: #131613;

    ScrollView {
        VerticalLayout {
            padding: 6px;
            spacing: 8px;
            alignment: start;

            SectionLabel { text: "tiles (384, 16 across)"; }
            TileMapView {
                source: PpuState.tiles;
                title: "tilemap";
                cells-x: 16;
                cells-y: 24;
                scale: 2;
            }

            SectionLabel { text: "background map"; }
            TileMapView {
                source: PpuState.background-map;
                title: "background";
                cells-x: 32;
                cells-y: 32;
                tile-numbers: PpuState.background-tiles;
                scale: 1;
            }

            SectionLabel { text: "window map"; }
            TileMapView {
                source: PpuState.window-map;
                title: "window";
                cells-x: 32;
                cells-y: 32;
                tile-numbers: PpuState.window-tiles;
                scale: 1;
            }

            SectionLabel {
                text: "OAM (40 sprites" + (PpuState.tall-sprites ? ", 8x16)" : ", 8x8)");
            }
            SpriteGrid {
                atlas: PpuState.tiles;
                sprites: PpuState.oam;
                tall: PpuState.tall-sprites;
                columns: 8;
                scale: 3;
            }

            SectionLabel {
                text: "sprite buffer (" + PpuState.sprite-buffer-len + " active)";
            }
            SpriteGrid {
                atlas: PpuState.tiles;
                sprites: PpuState.sprite-buffer;
                tall: PpuState.tall-sprites;
                columns: 5;
                active-count: PpuState.sprite-buffer-len;
                scale: 3;
            }

            SectionLabel { text: "pixel FIFOs"; }
            Text {
                text: PpuState.background-fifo-text + "\n" + PpuState.sprite-fifo-text;
                color: #9fd39f;
                font-family: "monospace";
                font-size: 11px;
            }
        }
    }
}
