import { ScrollView } from "std-widgets.slint";
import { SpriteGrid, SpriteCell } from "sprite-grid.slint";
import { TileMapView } from "tile-map-view.slint";

export { SpriteCell }

component SectionLabel inherits Text {
    color: #6f8f6f;
    font-size: 11px;
}

export component PpuViewer inherits Rectangle {
    in property <image> tiles;
    in property <image> background-map;
    in property <image> window-map;
    in property <[int]> background-tiles;
    in property <[int]> window-tiles;
    in property <[SpriteCell]> oam;
    in property <[SpriteCell]> sprite-buffer;
    in property <int> sprite-buffer-len;
    in property <bool> tall-sprites;
    in property <string> background-fifo-text;
    in property <string> sprite-fifo-text;

    background: #131613;

    ScrollView {
        VerticalLayout {
            padding: 6px;
            spacing: 8px;
            alignment: start;

            SectionLabel { text: "tiles (384, 16 across)"; }
            TileMapView {
                source: root.tiles;
                title: "tilemap";
                cells-x: 16;
                cells-y: 24;
                scale: 2;
            }

            SectionLabel { text: "background map"; }
            TileMapView {
                source: root.background-map;
                title: "background";
                cells-x: 32;
                cells-y: 32;
                tile-numbers: root.background-tiles;
                scale: 1;
            }

            SectionLabel { text: "window map"; }
            TileMapView {
                source: root.window-map;
                title: "window";
                cells-x: 32;
                cells-y: 32;
                tile-numbers: root.window-tiles;
                scale: 1;
            }

            SectionLabel {
                text: "OAM (40 sprites" + (root.tall-sprites ? ", 8x16)" : ", 8x8)");
            }
            SpriteGrid {
                atlas: root.tiles;
                sprites: root.oam;
                tall: root.tall-sprites;
                columns: 8;
                scale: 3;
            }

            SectionLabel {
                text: "sprite buffer (" + root.sprite-buffer-len + " active)";
            }
            SpriteGrid {
                atlas: root.tiles;
                sprites: root.sprite-buffer;
                tall: root.tall-sprites;
                columns: 5;
                active-count: root.sprite-buffer-len;
                scale: 3;
            }

            SectionLabel { text: "pixel FIFOs"; }
            Text {
                text: root.background-fifo-text + "\n" + root.sprite-fifo-text;
                color: #9fd39f;
                font-family: "monospace";
                font-size: 11px;
            }
        }
    }
}
