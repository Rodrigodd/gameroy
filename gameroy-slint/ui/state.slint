// The whole contract between the host and the UI.
//
// Every value the front-end pushes in, and every action the UI reports back,
// lives on a global here. That is not decoration: Slint only exposes a property
// to Rust if it sits on the compiled root or on an exported global, and routing
// everything through the root is what forced each screen's data to be declared
// once on the window, once on every intermediate component, and once more where
// it was finally used.
//
// A global reaches any depth without help from its ancestors, so a screen binds
// what it needs directly and the components above it stay ignorant of it.
//
// Reusable widgets -- GameScreen, SpriteGrid, TileMapView and the file-private
// helpers -- deliberately do *not* read these. They take properties, so they can
// still be previewed on their own.

export struct RomRow {
    file: string,
    title: string,
    size: string,
    last-played: string,
    /// Box art. An empty image until the loader has one, which is most of them.
    thumb: image,
    /// The loader has not reached this row yet.
    loading: bool,
}

/// The ROM library screen.
export global LibraryState {
    in property <[RomRow]> roms;
    in property <int> sort-column;
    in property <bool> sort-ascending;
    in property <string> folder-text;
    /// Position in `roms`, or -1 for no selection.
    in property <int> selected: -1;

    callback sort-by(int);
    callback activate(int);
    callback select(int);
    callback pick-rom();
    callback pick-folder();
}

export struct BreakRow {
    address: int,
    address-text: string,
    flags-text: string,
}

export struct WatchRow {
    address: int,
    address-text: string,
    value-text: string,
}

/// The debugger side panel: registers, breaks, watches and the console.
export global DebuggerState {
    in property <string> cpu-text;
    in property <string> ppu-text;
    in property <[BreakRow]> breakpoints;
    in property <[WatchRow]> watches;
    in property <[string]> console-lines;

    callback remove-breakpoint(int);
    callback remove-watch(int);
    callback add-breakpoint(string);
    callback add-watch(string);
    callback submit-command(string);
    /// Walks the submitted-command history. -1 is older, +1 is newer; the host
    /// answers with the text to put in the field, or "" at the end.
    pure callback history(int) -> string;
}

export struct DisasmRow {
    address-text: string,
    label: string,
    mnemonic: string,
    operand-prefix: string,
    /// The clickable run. Empty when the instruction does not jump.
    link-text: string,
    operand-suffix: string,
    /// Row index of the jump destination, -1 when this row has no link. Valid
    /// only while the trace has not grown; the host falls back to the address.
    jump-index: int,
    jump-bank: int,
    jump-address: int,
    /// CPU address, for the breakpoint gutter.
    address: int,
    bank: int,
    in-bank: int,
    is-current: bool,
    has-breakpoint: bool,
    /// False for a row the client has not fetched yet.
    loaded: bool,
}

/// The disassembly listing.
///
/// `rows` is a model over the *whole* trace, handed over once and mutated in
/// place afterwards; only the visible rows are ever asked for, and
/// `visible-range-changed` is how the host learns it must fetch more.
export global DisasmState {
    in property <[DisasmRow]> rows;
    in property <int> total;
    /// Row to bring into view, applied when `focus-token` changes rather than
    /// when this does: stepping inside a one-instruction loop leaves the index
    /// the same and must still re-centre.
    in property <int> focus-index: -1;
    in property <int> focus-token;

    callback jump-to(index: int, bank: int, address: int);
    callback toggle-breakpoint(address: int);
    callback visible-range-changed(first: int, count: int);
}

export struct SpriteCell {
    /// Index into the atlas, 16 tiles per row.
    tile: int,
    /// "x 4c  y 1a  tile 2f  flags 00", formatted on the Rust side.
    text: string,
    /// Parked outside the visible area. The old viewer tinted these red.
    offscreen: bool,
}

/// The PPU viewer tab.
///
/// `show-viewer` is the tab selection, written by the UI and reported back so
/// the host can start or stop paying for the image buffers behind the rest.
export global PpuState {
    in-out property <bool> show-viewer;
    callback viewer-toggled(bool);

    in property <image> tiles;
    in property <image> background-map;
    in property <image> window-map;
    in property <[int]> background-tiles;
    in property <[int]> window-tiles;
    in property <[SpriteCell]> oam;
    in property <[SpriteCell]> sprite-buffer;
    in property <int> sprite-buffer-len;
    in property <bool> tall-sprites;
    in property <string> background-fifo-text;
    in property <string> sprite-fifo-text;
}

/// The window shell: which screen is up, and what the title bar and the status
/// line say.
export global Shell {
    in property <string> window-title: "GameRoy";
    in property <string> status-text;
    /// False shows the ROM library instead of the emulator.
    in property <bool> playing;
    in property <bool> menu-open;
    /// A file is being dragged over the window. Set from the winit hook in
    /// main.rs, not from a DropArea: see the comment there.
    in property <bool> drop-hover;
}

/// Raw key events.
///
/// Only the joypad and the two hold-to-act keys come through here, because those
/// need to know whether the key is down. Momentary shortcuts are dispatched by
/// the host from `key-pressed`, since their bindings are configurable and a
/// `KeyBinding`'s keys are fixed at compile time.
export global Input {
    callback key-pressed(KeyEvent);
    callback key-released(KeyEvent);
    /// True when the key is one the joypad or a hold action uses.
    pure callback is-handled-key(string) -> bool;
}

/// The playing screen.
export global EmulatorState {
    in property <image> frame;
    in property <bool> integer-scaling;
    in property <bool> debugging;
}

/// The in-game pause menu. Emulation is paused for as long as it is up.
export global MenuActions {
    callback save-state();
    callback load-state();
    callback reset();
    callback toggle-scaling();
    callback exit-game();
    callback close();
}
